<Project>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' and '$(LOCALAPPDATA)' != ''">
    <GymTrackBuildRoot>$(LOCALAPPDATA)\GymTrackBuild\$([MSBuild]::StableStringHash('$(MSBuildThisFileDirectory)'))\</GymTrackBuildRoot>
    <BaseIntermediateOutputPath>$(GymTrackBuildRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(GymTrackBuildRoot)bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
