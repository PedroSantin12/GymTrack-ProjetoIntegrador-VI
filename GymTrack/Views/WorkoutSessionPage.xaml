<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="GymTrack.Views.WorkoutSessionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:GymTrack.ViewModels"
    x:DataType="viewModels:WorkoutSessionViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border StrokeShape="Rectangle"
                Padding="16,14">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding WorkoutName}"
                               Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding ElapsedTimeText}"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="{StaticResource BrandAccent}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Finalizar treino"
                            Command="{Binding FinishCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </Grid>

                <ProgressBar Progress="{Binding Progress}"
                             IsVisible="{Binding HasProgress}" />
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Label Text="{Binding ProgressText}"
                           Style="{StaticResource CaptionText}" />
                    <Label Grid.Column="1"
                           Text="{Binding VolumeText}"
                           Style="{StaticResource CaptionText}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource PagePadding}"
                                 Spacing="{StaticResource Spacing12}"
                                 BindableLayout.ItemsSource="{Binding Exercises}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SessionExerciseItemViewModel">
                        <Border Padding="14"
                                Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource SectionTitle}" />
                                    <Label Text="{Binding MuscleGroup}"
                                           Style="{StaticResource SecondaryText}" />
                                    <Label Text="{Binding PreviousPerformanceText}"
                                           Style="{StaticResource CaptionText}" />
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="36,*,60,60,90"
                                      ColumnSpacing="4">
                                    <Label Text="Série"
                                           FontSize="11"
                                           HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="1"
                                           Text="Anterior"
                                           FontSize="11"
                                           HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="2"
                                           Text="kg"
                                           FontSize="11"
                                           HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="3"
                                           Text="Reps"
                                           FontSize="11"
                                           HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="4"
                                           Text="Concluir"
                                           FontSize="11"
                                           HorizontalTextAlignment="Center" />
                                </Grid>

                                <VerticalStackLayout Spacing="8"
                                                     BindableLayout.ItemsSource="{Binding Sets}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:SessionSetItemViewModel">
                                            <Border Padding="6">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsCompleted}"
                                                                 Value="True">
                                                        <Setter Property="Stroke"
                                                                Value="{StaticResource BrandAccent}" />
                                                        <Setter Property="StrokeThickness"
                                                                Value="2" />
                                                    </DataTrigger>
                                                </Border.Triggers>

                                                <Grid RowDefinitions="Auto,Auto"
                                                      ColumnDefinitions="36,*,60,60,90"
                                                      ColumnSpacing="4"
                                                      RowSpacing="4">
                                                    <Label Text="{Binding SetNumberText}"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding PreviousText}"
                                                           Style="{StaticResource CaptionText}"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center" />
                                                    <Entry Grid.Column="2"
                                                           Text="{Binding LoadText, Mode=TwoWay}"
                                                           Keyboard="Numeric"
                                                           MaxLength="8"
                                                           FontSize="13"
                                                           MinimumHeightRequest="44"
                                                           HorizontalTextAlignment="Center"
                                                           IsReadOnly="{Binding IsCompleted}" />
                                                    <Entry Grid.Column="3"
                                                           Text="{Binding RepsText, Mode=TwoWay}"
                                                           Keyboard="Numeric"
                                                           MaxLength="5"
                                                           FontSize="13"
                                                           MinimumHeightRequest="44"
                                                           HorizontalTextAlignment="Center"
                                                           IsReadOnly="{Binding IsCompleted}" />
                                                    <VerticalStackLayout Grid.Column="4"
                                                                         Spacing="2">
                                                        <Button Text="{Binding CompletionText}"
                                                                Command="{Binding CompleteCommand}"
                                                                IsEnabled="{Binding CanComplete}"
                                                                FontSize="12"
                                                                Padding="4" />
                                                        <Button Text="Remover"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding RemoveCommand}"
                                                                IsVisible="{Binding CanRemove}"
                                                                IsEnabled="{Binding CanRemove}"
                                                                FontSize="11"
                                                                Padding="4" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Row="1"
                                                           Grid.ColumnSpan="5"
                                                           Text="{Binding ValidationMessage}"
                                                           IsVisible="{Binding HasValidationMessage}"
                                                           TextColor="{StaticResource Danger}"
                                                           Style="{StaticResource CaptionText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Button Text="Adicionar série"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding AddSetCommand}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2"
              Padding="16,8"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />
            <Label Grid.Column="1"
                   Text="{Binding ValidationMessage}"
                   IsVisible="{Binding HasValidationMessage}"
                   TextColor="{StaticResource Danger}"
                   VerticalTextAlignment="Center" />
        </Grid>
    </Grid>
</ContentPage>
