<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="GymTrack.Views.ExercisePickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:GymTrack.ViewModels"
    x:DataType="viewModels:ExercisePickerViewModel"
    Title="Adicionar exercício">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Fechar"
                     Command="{Binding CloseCommand}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="{StaticResource PagePadding}"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="{StaticResource Spacing12}">
        <SearchBar Placeholder="Buscar exercício"
                   Text="{Binding SearchText, Mode=TwoWay}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Text="‹ Grupos musculares"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ShowGroupsCommand}"
                    IsVisible="{Binding IsExerciseListVisible}" />
            <Button x:Name="ManageExercisesButton"
                    Grid.Column="1"
                    Text="Gerenciar exercícios"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ManageExercisesCommand}" />
        </Grid>

        <ScrollView Grid.Row="2"
                    IsVisible="{Binding IsGroupSelectionVisible}">
            <VerticalStackLayout x:Name="GroupSections"
                                 Spacing="22"
                                 Padding="0,6,0,24" />
        </ScrollView>

        <RefreshView Grid.Row="2"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                     IsVisible="{Binding IsExerciseListVisible}">
            <CollectionView ItemsSource="{Binding Exercises}"
                            SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="4" Padding="0,2,0,14">
                        <Label Text="{Binding ActiveGroupTitle}"
                               Style="{StaticResource SectionTitle}" />
                        <Label Text="Toque em Ver execução para consultar o guia."
                               Style="{StaticResource CaptionText}" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         MaximumWidthRequest="320">
                        <Label Text="Nenhum exercício disponível"
                               Style="{StaticResource SectionTitle}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Escolha outro grupo ou ajuste a busca."
                               Style="{StaticResource SecondaryText}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ExercisePickerItemViewModel">
                        <Border Margin="0,0,0,10"
                                Padding="12">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="88,*"
                                      ColumnSpacing="12">
                                    <Border WidthRequest="84"
                                            HeightRequest="64"
                                            Padding="3"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="#191919">
                                        <Grid>
                                            <Image Source="{Binding PreviewSource}"
                                                   IsVisible="{Binding HasPreview}"
                                                   Aspect="AspectFit"
                                                   BackgroundColor="White"
                                                   SemanticProperties.Description="Ilustração do exercício" />
                                            <Label Text="SEM MÍDIA"
                                                   IsVisible="{Binding HasNoPreview}"
                                                   FontSize="9"
                                                   TextColor="#A4A5AC"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               Style="{StaticResource SectionTitle}"
                                               FontSize="16" />
                                        <Label Text="{Binding MuscleGroup}"
                                               Style="{StaticResource SecondaryText}"
                                               FontSize="12" />
                                        <Label Text="{Binding Notes}"
                                               Style="{StaticResource CaptionText}"
                                               IsVisible="{Binding HasNotes}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Text="Ver execução"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding PreviewCommand}"
                                            FontSize="13"
                                            Padding="6,8" />
                                    <Button Grid.Column="1"
                                            Text="Adicionar"
                                            Command="{Binding SelectCommand}"
                                            FontSize="13"
                                            Padding="6,8" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid Grid.Row="3"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="{StaticResource Spacing8}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding StatusMessage}"
                   TextColor="{StaticResource Danger}"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center" />
        </Grid>
    </Grid>
</ContentPage>
