<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="GymTrack.Views.ExercisePickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:GymTrack.ViewModels"
    x:DataType="viewModels:ExercisePickerViewModel"
    Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Fechar"
                     Command="{Binding CloseCommand}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="{StaticResource PagePadding}"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="{StaticResource Spacing12}">
        <SearchBar Placeholder="Buscar exercício por nome"
                   Text="{Binding SearchText, Mode=TwoWay}" />

        <Button Grid.Row="1"
                Text="Gerenciar exercícios"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding ManageExercisesCommand}" />

        <RefreshView Grid.Row="2"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Exercises}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         MaximumWidthRequest="320">
                        <Label Text="Nenhum exercício disponível"
                               Style="{StaticResource SectionTitle}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Ajuste a busca ou use Gerenciar exercícios para cadastrar um novo."
                               Style="{StaticResource SecondaryText}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ExercisePickerItemViewModel">
                        <Border Margin="0,0,0,8"
                                Padding="16,12">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                    </VerticalStackLayout.GestureRecognizers>

                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource SectionTitle}" />
                                    <Label Text="{Binding MuscleGroup}"
                                           Style="{StaticResource SecondaryText}" />
                                    <Label Text="{Binding Notes}"
                                           Style="{StaticResource CaptionText}"
                                           IsVisible="{Binding HasNotes}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="Adicionar"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelectCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid Grid.Row="3"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="{StaticResource Spacing8}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding StatusMessage}"
                   TextColor="{StaticResource Danger}"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center" />
        </Grid>
    </Grid>
</ContentPage>
