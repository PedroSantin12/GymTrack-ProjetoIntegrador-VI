<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="GymTrack.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:GymTrack.ViewModels"
    x:DataType="viewModels:DashboardViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}"
                             Spacing="{StaticResource Spacing24}">
            <VerticalStackLayout Spacing="{StaticResource Spacing8}">
                <Image Source="gymtrack_logo.svg"
                       HeightRequest="64"
                       HorizontalOptions="Start"
                       Aspect="AspectFit"
                       SemanticProperties.Description="Logotipo GymTrack" />
                <Label Text="Olá. Organize seu treino e acompanhe sua evolução."
                       Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>

            <Border>
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="{StaticResource Spacing12}">
                    <Label Text="Iniciar treino"
                           Style="{StaticResource SectionTitle}" />
                    <Picker Grid.Row="1"
                            Title="Escolha um treino"
                            ItemsSource="{Binding Workouts}"
                            SelectedItem="{Binding SelectedWorkout, Mode=TwoWay}"
                            IsVisible="{Binding HasWorkouts}" />
                    <VerticalStackLayout Grid.Row="1" Spacing="8" IsVisible="{Binding HasNoWorkouts}">
                        <Label Text="Crie seu primeiro treino para começar."
                               Style="{StaticResource SecondaryText}" />
                        <Button Text="Criar treino"
                                Command="{Binding OpenWorkoutsCommand}" />
                    </VerticalStackLayout>
                    <Button Grid.Row="2"
                            Text="Iniciar treino"
                            Command="{Binding StartWorkoutCommand}"
                            IsVisible="{Binding HasWorkouts}" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="{StaticResource Spacing8}">
                <Label Text="Último treino" Style="{StaticResource SectionTitle}" />
                <Label Text="{Binding LastWorkoutName}" FontAttributes="Bold" />
                <Label Text="{Binding LastWorkoutDetails}" Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource Spacing12}">
                <Label Text="Resumo"
                       Style="{StaticResource SectionTitle}" />
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="{StaticResource Spacing12}">
                    <Border Grid.Column="0" Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding WeeklySessionsText}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="22" />
                            <Label Text="sessões nesta semana"
                                   Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding WeeklyVolumeText}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="22" />
                            <Label Text="volume semanal"
                                   Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource Spacing8}">
                <Label Text="Recentes"
                       Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentSessions}" Spacing="10" IsVisible="{Binding HasRecentSessions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:HistorySessionItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="3">
                                <Label Text="{Binding WorkoutName}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding VolumeText}" Style="{StaticResource CaptionText}" />
                                <Label Grid.Row="1" Text="{Binding DateText}" Style="{StaticResource CaptionText}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Suas sessões concluídas aparecerão aqui."
                       IsVisible="{Binding HasNoRecentSessions}"
                       Style="{StaticResource SecondaryText}" />
                <Button Text="Ver histórico"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenHistoryCommand}"
                        IsVisible="{Binding HasRecentSessions}" />
            </VerticalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
