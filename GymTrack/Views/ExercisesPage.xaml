<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="GymTrack.Views.ExercisesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:GymTrack.ViewModels"
    x:DataType="viewModels:ExercisesViewModel"
    Title="{Binding Title}">

    <Grid x:Name="ExerciseContent"
          Padding="18,14,18,12"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label x:Name="ExerciseTitle" Text="Exercícios" FontSize="24"
                   FontFamily="OpenSansSemibold" VerticalTextAlignment="Center"
                   IsVisible="False" />
            <Button Grid.Column="1" Text="Novo exercício"
                    Command="{Binding AddExerciseCommand}" />
        </Grid>

        <SearchBar Grid.Row="1" Placeholder="Buscar por nome"
                   Text="{Binding SearchText, Mode=TwoWay}" />

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto"
              RowSpacing="4"
              ColumnSpacing="{StaticResource Spacing8}">
            <Label Text="Grupo muscular" Style="{StaticResource CaptionText}" />
            <Border Grid.Row="1" Padding="0" StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.ColumnSpan="2"
                            Clicked="OnChooseMuscleGroup"
                            AutomationId="FilterMuscleGroup"
                            SemanticProperties.Description="{Binding SelectedMuscleGroup, StringFormat='Grupo muscular, {0}'}"
                            Style="{StaticResource QuietButton}" />
                    <Label Text="{Binding SelectedMuscleGroup}"
                           Margin="12,4,0,4"
                           InputTransparent="True"
                           VerticalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <Path Grid.Column="1"
                          Data="M 1,1 L 7,7 L 13,1"
                          Stroke="{StaticResource DarkTextSecondary}"
                          StrokeThickness="1.5"
                          WidthRequest="13"
                          HeightRequest="7"
                          Aspect="Uniform"
                          Margin="10,0,12,0"
                          InputTransparent="True"
                          VerticalOptions="Center" />
                </Grid>
            </Border>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Text="Limpar"
                    Style="{StaticResource SecondaryButton}"
                    FontSize="12"
                    MinimumHeightRequest="44"
                    Padding="10,4"
                    VerticalOptions="End"
                    Command="{Binding ClearFiltersCommand}" />
        </Grid>

        <RefreshView Grid.Row="3"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Exercises}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         MaximumWidthRequest="320">
                        <Label Text="Nenhum exercício encontrado"
                               Style="{StaticResource SectionTitle}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Cadastre um exercício ou ajuste a busca e o filtro."
                               Style="{StaticResource SecondaryText}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ExerciseListItemViewModel">
                        <Border Margin="0,0,0,6"
                                Padding="10,8">
                            <Grid ColumnDefinitions="52,*,Auto"
                                  ColumnSpacing="8">
                                <Border HeightRequest="44"
                                        Padding="2"
                                        VerticalOptions="Center"
                                        BackgroundColor="#191919"
                                        StrokeShape="RoundRectangle 9">
                                    <Grid>
                                        <Image Source="{Binding PreviewSource}"
                                               IsVisible="{Binding HasPreview}"
                                               Aspect="AspectFit"
                                               BackgroundColor="White"
                                               SemanticProperties.Description="Ilustração do exercício" />
                                        <Label Text="SEM MÍDIA"
                                               IsVisible="{Binding HasNoPreview}"
                                               FontSize="9"
                                               TextColor="#A4A5AC"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding EditCommand}" />
                                    </VerticalStackLayout.GestureRecognizers>

                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource SectionTitle}"
                                           FontSize="15"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"
                                           ToolTipProperties.Text="{Binding Name}" />
                                    <Label Text="{Binding MuscleGroup}"
                                           Style="{StaticResource CaptionText}"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding StateText}"
                                           Style="{StaticResource CaptionText}"
                                           FontSize="11">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsActive}"
                                                         Value="False">
                                                <Setter Property="TextColor"
                                                        Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="Ações"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="12"
                                        MinimumHeightRequest="44"
                                        Padding="8,4"
                                        VerticalOptions="Center"
                                        Command="{Binding ActionsCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Grid.Row="4"
               Text="{Binding StatusMessage}"
               TextColor="{StaticResource Danger}"
               HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>
