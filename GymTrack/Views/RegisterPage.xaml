<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:GymTrack.Views.Components"
             xmlns:viewModels="clr-namespace:GymTrack.ViewModels"
             x:Class="GymTrack.Views.RegisterPage"
             x:DataType="viewModels:RegisterViewModel"
             Title="Cadastrar-se"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource DarkBackground}">
    <Grid>
        <Image Source="register_background.png" Aspect="AspectFill" InputTransparent="True" />
        <BoxView InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#AF0E0E10" Offset="0" />
                    <GradientStop Color="#450E0E10" Offset="0.24" />
                    <GradientStop Color="#B90E0E10" Offset="0.48" />
                    <GradientStop Color="#F90E0E10" Offset="0.68" />
                    <GradientStop Color="#0E0E10" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,*" RowSpacing="12"
              Padding="22,24" MaximumWidthRequest="440">
            <components:BrandLockup x:Name="BrandHeader" />

            <ScrollView Grid.Row="1" VerticalOptions="End" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Crie sua conta"
                           FontSize="25"
                           FontFamily="OpenSansSemibold"
                           SemanticProperties.HeadingLevel="Level1"
                           Margin="0,0,0,4" />

                <Entry x:Name="NameInput"
                       Style="{StaticResource AuthEntryStyle}"
                       Text="{Binding Name}"
                       Placeholder="Nome completo"
                       ReturnType="Next"
                       Completed="OnNameCompleted"
                       MaxLength="100"
                       SemanticProperties.Description="Nome completo"
                       AutomationId="RegisterName" />

                <Entry x:Name="EmailInput"
                       Style="{StaticResource AuthEntryStyle}"
                       Text="{Binding Email}"
                       Placeholder="E-mail"
                       Keyboard="Email"
                       ReturnType="Next"
                       Completed="OnEmailCompleted"
                       MaxLength="254"
                       SemanticProperties.Description="E-mail"
                       AutomationId="RegisterEmail" />

                <Entry x:Name="PasswordInput"
                       Style="{StaticResource AuthEntryStyle}"
                       Text="{Binding Password}"
                       Placeholder="Senha (mínimo 8 caracteres)"
                       IsPassword="True"
                       ReturnType="Next"
                       Completed="OnPasswordCompleted"
                       MaxLength="128"
                       SemanticProperties.Description="Senha, mínimo de oito caracteres"
                       AutomationId="RegisterPassword" />

                <Entry x:Name="ConfirmPasswordInput"
                       Style="{StaticResource AuthEntryStyle}"
                       Text="{Binding ConfirmPassword}"
                       Placeholder="Confirmar senha"
                       IsPassword="True"
                       ReturnType="Go"
                       ReturnCommand="{Binding RegisterCommand}"
                       MaxLength="128"
                       SemanticProperties.Description="Confirmar senha"
                       AutomationId="RegisterConfirmPassword" />

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Danger}"
                           FontSize="12"
                           AutomationId="RegisterError" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,2,0,0">
                        <Button Text="Cadastrar"
                                Command="{Binding RegisterCommand}"
                                Padding="8,10"
                                AutomationId="RegisterSubmit" />
                        <Button Grid.Column="1"
                                Text="Voltar"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,10"
                                Clicked="OnBackClicked"
                                AutomationId="RegisterBack" />
                    </Grid>

                    <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
