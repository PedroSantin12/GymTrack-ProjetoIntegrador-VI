<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="GymTrack.Views.ProgressPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:viewModels="clr-namespace:GymTrack.ViewModels"
    x:DataType="viewModels:ProgressViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}"
                             Spacing="{StaticResource Spacing24}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Evolução"
                       Style="{StaticResource PageTitle}" />
                <Label Text="Acompanhe carga e volume por exercício."
                       Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>

            <Border>
                <VerticalStackLayout Spacing="{StaticResource Spacing12}">
                    <Label Text="Exercício"
                           Style="{StaticResource CaptionText}" />
                    <Picker Title="Registre exercícios para selecionar"
                            ItemDisplayBinding="{Binding Name}"
                            ItemsSource="{Binding Exercises}"
                            SelectedItem="{Binding SelectedExercise, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="{StaticResource Spacing8}">
                <Label Text="Métrica"
                       Style="{StaticResource SectionTitle}" />
                <HorizontalStackLayout Spacing="{StaticResource Spacing16}">
                    <RadioButton Content="Maior carga"
                                 GroupName="ProgressMetric"
                                 IsChecked="{Binding IsMaxLoadSelected, Mode=TwoWay}" />
                    <RadioButton Content="Volume"
                                 GroupName="ProgressMetric"
                                 IsChecked="{Binding IsVolumeSelected, Mode=TwoWay}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Border MinimumHeightRequest="280">
                <Grid>
                    <lvc:CartesianChart Series="{Binding Series}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        HeightRequest="280"
                                        IsVisible="{Binding HasChart}"
                                        LegendPosition="Hidden"
                                        ZoomMode="None" />
                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         IsVisible="{Binding IsEmpty}">
                        <Label Text="Sem dados para o gráfico"
                               Style="{StaticResource SectionTitle}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Registre ao menos duas sessões deste exercício para visualizar a evolução."
                               Style="{StaticResource SecondaryText}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Border>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Melhor carga" Style="{StaticResource CaptionText}" />
                        <Label Text="{Binding BestLoadText}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Última carga" Style="{StaticResource CaptionText}" />
                        <Label Text="{Binding LastLoadText}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Sessões" Style="{StaticResource CaptionText}" />
                        <Label Text="{Binding SessionCountText}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Variação" Style="{StaticResource CaptionText}" />
                        <Label Text="{Binding VariationText}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatusMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
