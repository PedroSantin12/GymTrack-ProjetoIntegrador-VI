<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:GymTrack.Views.Components"
             xmlns:viewModels="clr-namespace:GymTrack.ViewModels"
             x:Class="GymTrack.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="Entrar"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource DarkBackground}">
    <Grid>
        <Image Source="login_background.png" Aspect="AspectFill" InputTransparent="True" />
        <BoxView InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#AF0E0E10" Offset="0" />
                    <GradientStop Color="#450E0E10" Offset="0.24" />
                    <GradientStop Color="#B90E0E10" Offset="0.48" />
                    <GradientStop Color="#F90E0E10" Offset="0.68" />
                    <GradientStop Color="#0E0E10" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,*" RowSpacing="12"
              Padding="22,24" MaximumWidthRequest="440">
            <components:BrandLockup x:Name="BrandHeader" />

            <ScrollView Grid.Row="1" VerticalOptions="End" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Acesse sua conta"
                           FontSize="25"
                           FontFamily="OpenSansSemibold"
                           SemanticProperties.HeadingLevel="Level1"
                           Margin="0,0,0,4" />

                <Entry x:Name="EmailInput"
                       Style="{StaticResource AuthEntryStyle}"
                       Text="{Binding Email}"
                       Placeholder="E-mail"
                       Keyboard="Email"
                       ReturnType="Next"
                       Completed="OnEmailCompleted"
                       MaxLength="254"
                       SemanticProperties.Description="E-mail"
                       AutomationId="LoginEmail" />

                <Entry x:Name="PasswordInput"
                       Style="{StaticResource AuthEntryStyle}"
                       Text="{Binding Password}"
                       Placeholder="Senha"
                       IsPassword="True"
                       ReturnType="Go"
                       ReturnCommand="{Binding SignInCommand}"
                       MaxLength="128"
                       SemanticProperties.Description="Senha"
                       AutomationId="LoginPassword" />

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Danger}"
                           FontSize="12"
                           AutomationId="LoginError" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,2,0,0">
                        <Button Text="Entrar"
                                Command="{Binding SignInCommand}"
                                Padding="8,10"
                                AutomationId="LoginSubmit" />
                        <Button Grid.Column="1"
                                Text="Cadastrar-se"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,10"
                                Clicked="OnRegisterClicked"
                                AutomationId="OpenRegistration" />
                    </Grid>

                    <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
