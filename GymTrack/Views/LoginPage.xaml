<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:GymTrack.ViewModels"
             x:Class="GymTrack.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="Entrar"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource DarkBackground}">
    <Grid>
        <Image Source="login_background.png" Aspect="AspectFill" />
        <BoxView Color="#40000000" InputTransparent="True" />

        <Grid RowDefinitions="Auto,*,Auto" Padding="24,20,24,28" MaximumWidthRequest="500">
            <Image x:Name="BrandLogo"
                   Source="gymtrack_logo.svg"
                   WidthRequest="278"
                   HeightRequest="78"
                   HorizontalOptions="Start"
                   Margin="0,12,0,0"
                   SemanticProperties.Description="GymTrack" />

            <Border Grid.Row="2"
                    Padding="18,22"
                    BackgroundColor="#E0212121"
                    Stroke="#80595959"
                    StrokeShape="RoundRectangle 26">
                <VerticalStackLayout Spacing="12">
                    <Border Padding="12,0" BackgroundColor="#CC272727" Stroke="#707070" StrokeShape="RoundRectangle 15">
                        <Entry x:Name="EmailInput"
                               Text="{Binding Email}"
                               Placeholder="E-mail"
                               Keyboard="Email"
                               ReturnType="Next"
                               Completed="OnEmailCompleted"
                               MaxLength="254"
                               SemanticProperties.Description="E-mail"
                               AutomationId="LoginEmail" />
                    </Border>

                    <Border Padding="12,0" BackgroundColor="#CC272727" Stroke="#707070" StrokeShape="RoundRectangle 15">
                        <Entry x:Name="PasswordInput"
                               Text="{Binding Password}"
                               Placeholder="Senha"
                               IsPassword="True"
                               ReturnType="Go"
                               ReturnCommand="{Binding SignInCommand}"
                               SemanticProperties.Description="Senha"
                               AutomationId="LoginPassword" />
                    </Border>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Danger}"
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           AutomationId="LoginError" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Entrar"
                                Command="{Binding SignInCommand}"
                                FontSize="14"
                                Padding="8,10"
                                AutomationId="LoginSubmit" />
                        <Button Grid.Column="1"
                                Text="Cadastrar-se"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="13"
                                Padding="8,10"
                                Clicked="OnRegisterClicked"
                                AutomationId="OpenRegistration" />
                    </Grid>

                    <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
